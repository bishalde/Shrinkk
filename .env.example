# MongoDB connection. Use mongomock:// for a throwaway in-memory database.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=shrinkk

# Required in production: a long random string (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=

# Optional: force a canonical origin for short links and QR codes.
# Leave unset to use whatever domain the site is visited on.
# BASE_URL=https://shrinkk.vercel.app
